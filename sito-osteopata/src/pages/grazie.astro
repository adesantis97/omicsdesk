---
import Base from '../layouts/Base.astro';
import { whatsappUrl } from '../data/site.ts';
---

<Base title="Grazie per la tua richiesta" noIndex>
  <div class="container-x py-24 max-w-xl text-center">
    <div class="w-16 h-16 mx-auto rounded-full bg-indigo-100 text-indigo-500 grid place-items-center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1 class="mt-6 text-3xl text-petrol-700">Richiesta inviata!</h1>
    <p class="mt-3 text-ink/70">
      Grazie per avermi scritto. Ti risponderò il prima possibile, di solito in giornata.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-outline">Torna alla home</a>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp">Scrivimi su WhatsApp</a>
    </div>
  </div>
</Base>
