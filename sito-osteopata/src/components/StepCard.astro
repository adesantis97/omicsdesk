---
interface Props {
  numero: number;
  titolo: string;
  testo: string;
}
const { numero, titolo, testo } = Astro.props;
---

<div class="relative rounded-2xl bg-white border border-sand-200 p-6">
  <span class="w-9 h-9 rounded-full bg-brand-500 text-white grid place-items-center text-sm font-semibold">
    {numero}
  </span>
  <h3 class="mt-4 text-lg text-ink">{titolo}</h3>
  <p class="mt-2 text-sm text-ink/70 leading-relaxed">{testo}</p>
</div>
