---
interface Props {
  domanda: string;
}
const { domanda } = Astro.props;
---

<details class="group border-b border-sand-200 py-4">
  <summary class="flex items-center justify-between cursor-pointer list-none font-medium text-ink">
    <span>{domanda}</span>
    <svg class="w-5 h-5 text-brand-500 transition-transform group-open:rotate-45 shrink-0 ml-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </summary>
  <div class="mt-3 text-ink/70 leading-relaxed">
    <slot />
  </div>
</details>
