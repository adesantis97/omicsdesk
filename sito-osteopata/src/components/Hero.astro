---
import { site, whatsappUrl, indirizzoCompleto } from '../data/site.ts';
---

<!-- HERO a tutto schermo con foto grande.
     SEGNAPOSTO FOTO: quando avrai la foto, decommenta background-image qui sotto
     puntando a /images/hero.jpg (una foto verticale/di ambiente funziona meglio). -->
<section
  class="relative isolate overflow-hidden"
  style="background-image: linear-gradient(160deg, #0f5a54 0%, #0a3c38 45%, #3b419e 100%); /* background-image: url('/images/hero.jpg'); */ background-size: cover; background-position: center;"
>
  <!-- velo scuro per la leggibilità del testo -->
  <div class="absolute inset-0 bg-gradient-to-t from-petrol-900/80 via-petrol-900/35 to-petrol-900/45"></div>

  <div class="relative container-x pt-24 pb-44 sm:pt-32 sm:pb-52 text-center text-white">
    <p class="eyebrow text-lavender">{site.titolo} · {site.studio.citta}</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-4xl sm:text-6xl leading-[1.05]">
      {site.claim}
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg sm:text-xl text-white/85">
      {site.descrizioneBreve}
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-light">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.42 9.42 0 01-1.44-5.02c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.69 2.78a9.4 9.4 0 012.77 6.67c0 5.2-4.24 9.45-9.45 9.45z"/></svg>
        Prenota un appuntamento
      </a>
      <a href={`tel:${site.telefonoLink}`} class="btn-outline-light">Chiama ora</a>
    </div>
  </div>
</section>

<!-- Card contatti che sborda sopra la foto -->
<div class="container-x -mt-32 sm:-mt-36 relative z-10">
  <div class="rounded-4xl bg-petrol-600 text-white shadow-soft p-7 sm:p-9 grid gap-5 sm:grid-cols-3">
    <a href={whatsappUrl} target="_blank" rel="noopener" class="flex items-center gap-4 group">
      <span class="w-12 h-12 rounded-full bg-white/10 grid place-items-center shrink-0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.42 9.42 0 01-1.44-5.02c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.69 2.78a9.4 9.4 0 012.77 6.67c0 5.2-4.24 9.45-9.45 9.45z"/></svg>
      </span>
      <span>
        <span class="block text-xs uppercase tracking-wide text-lavender">WhatsApp</span>
        <span class="block font-semibold group-hover:underline">{site.telefono}</span>
      </span>
    </a>
    <a href={`tel:${site.telefonoLink}`} class="flex items-center gap-4 group">
      <span class="w-12 h-12 rounded-full bg-white/10 grid place-items-center shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
      <span>
        <span class="block text-xs uppercase tracking-wide text-lavender">Telefono</span>
        <span class="block font-semibold group-hover:underline">{site.telefono}</span>
      </span>
    </a>
    <a href={site.studio.mappaLink} target="_blank" rel="noopener" class="flex items-center gap-4 group">
      <span class="w-12 h-12 rounded-full bg-white/10 grid place-items-center shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <span>
        <span class="block text-xs uppercase tracking-wide text-lavender">Dove</span>
        <span class="block font-semibold group-hover:underline">{site.studio.citta}</span>
      </span>
    </a>
  </div>
</div>
