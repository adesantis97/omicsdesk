---
import { site, whatsappUrl } from '../data/site.ts';
---

<section class="bg-gradient-to-b from-brand-50 to-sand-50">
  <div class="container-x py-16 sm:py-24 grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm font-medium text-brand-700 shadow-sm">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-500"></span>
        {site.titolo} · {site.studio.citta}
      </p>
      <h1 class="mt-5 text-4xl sm:text-5xl leading-tight text-ink">
        {site.claim}
      </h1>
      <p class="mt-5 text-lg text-ink/70 max-w-xl">
        {site.descrizioneBreve}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={whatsappUrl} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 01-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.42 9.42 0 01-1.44-5.02c0-5.2 4.24-9.44 9.46-9.44 2.53 0 4.9.99 6.69 2.78a9.4 9.4 0 012.77 6.67c0 5.2-4.24 9.45-9.45 9.45zm8.05-17.5A11.36 11.36 0 0012.04 0C5.75 0 .63 5.12.63 11.4c0 2.01.53 3.97 1.53 5.7L.53 24l7.06-1.85a11.4 11.4 0 005.44 1.38h.01c6.28 0 11.4-5.12 11.4-11.4 0-3.05-1.19-5.91-3.35-8.06z"/></svg>
          Prenota su WhatsApp
        </a>
        <a href={`tel:${site.telefonoLink}`} class="btn-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Chiama ora
        </a>
      </div>
      <p class="mt-4 text-sm text-ink/50">Risposta in giornata · Prima valutazione su appuntamento</p>
    </div>

    <div class="relative">
      <!-- SEGNAPOSTO FOTO: sostituisci con la foto ritratto di tuo fratello (vedi CONTENUTI.md) -->
      <div class="aspect-[4/5] w-full max-w-md mx-auto rounded-3xl bg-brand-100 border border-brand-200 overflow-hidden grid place-items-center text-brand-400">
        <div class="text-center px-6">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="mx-auto"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>
          <p class="mt-3 text-sm">Foto ritratto<br />(segnaposto)</p>
        </div>
      </div>
    </div>
  </div>
</section>
