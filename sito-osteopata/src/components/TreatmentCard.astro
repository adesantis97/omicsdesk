---
interface Props {
  titolo: string;
  descrizione: string;
  icona: string;
}
const { titolo, descrizione, icona } = Astro.props;

const icons: Record<string, string> = {
  colonna:
    '<path d="M12 3v18"/><path d="M9 6h6"/><path d="M9 10h6"/><path d="M9 14h6"/><path d="M9 18h6"/>',
  mano: '<path d="M18 11V6a2 2 0 0 0-4 0v5"/><path d="M14 10V4a2 2 0 0 0-4 0v6"/><path d="M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2a8 8 0 0 1-6.8-3.7L3 16"/>',
  cuore: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>',
  testa: '<path d="M9 21h6"/><path d="M12 17c0-2 3-2 3-6a3 3 0 0 0-6 0c0 4 3 4 3 6z"/><path d="M12 3v2"/>',
  bimbo: '<circle cx="12" cy="7" r="3"/><path d="M6 21v-2a6 6 0 0 1 12 0v2"/>',
  gravidanza: '<circle cx="12" cy="4" r="2"/><path d="M12 7v6a4 4 0 0 0 4 4"/><path d="M12 13c-3 0-4-2-4-4"/>',
  sport: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/>',
  foglia: '<path d="M11 20A7 7 0 0 1 4 13c0-6 7-10 15-10 0 8-4 15-10 15z"/><path d="M4 20c3-3 6-4.5 9-6"/>',
};
const path = icons[icona] ?? icons.foglia;
---

<article class="rounded-4xl bg-white p-7 shadow-soft hover:-translate-y-1 transition duration-200">
  <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-500 grid place-items-center">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path} />
  </div>
  <h3 class="mt-5 text-2xl text-petrol-700">{titolo}</h3>
  <p class="mt-2.5 text-ink/70 leading-relaxed">{descrizione}</p>
</article>
