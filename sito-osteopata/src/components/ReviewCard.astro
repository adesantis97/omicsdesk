---
interface Props {
  autore: string;
  stelle: number;
  data?: string;
}
const { autore, stelle, data } = Astro.props;
---

<figure class="rounded-4xl bg-white p-7 shadow-soft flex flex-col">
  <div class="flex gap-0.5 text-amber-400" aria-label={`${stelle} stelle su 5`}>
    {
      Array.from({ length: 5 }).map((_, i) => (
        <svg width="20" height="20" viewBox="0 0 24 24" fill={i < stelle ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.7L12 17.3 5.8 20.8l1.6-6.7L2.2 8.9l6.9-.6z" />
        </svg>
      ))
    }
  </div>
  <blockquote class="mt-4 text-ink/80 leading-relaxed flex-1">
    <slot />
  </blockquote>
  <figcaption class="mt-5 font-semibold text-petrol-700">
    {autore}
    {data && <span class="font-normal text-ink/50"> · {data}</span>}
  </figcaption>
</figure>
