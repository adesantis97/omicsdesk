---
const year = new Date().getFullYear();
---
<footer class="max-w-5xl mx-auto px-5 py-block text-caption text-slate-600 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div class="flex items-center gap-2">
    <img src="/logo.png" alt="OmicsDesk" width="821" height="160" class="h-6 w-auto" />
    <span class="text-slate-600">· Your data, analyzed and explained.</span>
  </div>
  <div class="flex flex-wrap items-center gap-3 text-slate-600">
    <a href="https://www.linkedin.com/company/omicsdesk" target="_blank" rel="noopener" aria-label="OmicsDesk on LinkedIn" class="inline-flex items-center transition duration-250 ease-apple hover:text-ink">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
    </a>
    <span aria-hidden="true">·</span>
    <span>NDA available on request</span>
    <span aria-hidden="true">·</span>
    <a href="/privacy/" class="transition duration-250 ease-apple hover:text-ink">Privacy and cookies</a>
    <span aria-hidden="true">·</span>
    <button type="button" data-consent-open class="transition duration-250 ease-apple hover:text-ink underline-offset-4 hover:underline">
      Cookie preferences
    </button>
    <span aria-hidden="true">·</span>
    <span>© OmicsDesk {year}</span>
  </div>
</footer>
