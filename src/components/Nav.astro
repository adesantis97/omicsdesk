---
const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname === href + '/';
const links = [
  { href: '/case-studies/', label: 'Case studies', active: pathname.startsWith('/case-studies') },
  { href: '/validation/', label: 'Validation', active: pathname.startsWith('/validation') },
  { href: '/pricing/', label: 'Pricing', active: isActive('/pricing') },
  { href: '/publications/', label: 'Publications', active: isActive('/publications') },
  { href: '/blog/', label: 'Blog', active: pathname.startsWith('/blog') },
];
---
<nav class="sticky top-0 z-40 bg-paper/80 backdrop-blur-md border-b border-slate-200/60">
  <div class="max-w-5xl mx-auto px-5 py-3 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center shrink-0" aria-label="OmicsDesk home">
      <img src="/logo.png" alt="OmicsDesk" width="821" height="160" class="h-7 sm:h-8 w-auto" />
    </a>

    <div class="hidden md:flex items-center gap-6 text-sm text-slate-600">
      {links.map((l) => (
        <a href={l.href} class={`hover:text-ink ${l.active ? 'text-ink font-medium' : ''}`}>{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="https://www.linkedin.com/company/omicsdesk" target="_blank" rel="noopener" aria-label="OmicsDesk on LinkedIn" class="hidden sm:inline-flex text-slate-500 hover:text-ink">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href="mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20request%20a%20quote" class="hidden sm:inline-flex text-sm font-medium bg-ink text-white px-3.5 py-1.5 rounded-md hover:bg-slate-800 transition">
        Request a quote
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md text-ink hover:bg-slate-100 transition"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="mobile-menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        <svg id="mobile-menu-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white">
    <div class="max-w-5xl mx-auto px-5 py-3 flex flex-col text-base">
      {links.map((l) => (
        <a href={l.href} class={`py-2.5 border-b border-slate-100 last:border-b-0 ${l.active ? 'text-ink font-medium' : 'text-slate-700'} hover:text-ink`}>{l.label}</a>
      ))}
      <a href="mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20request%20a%20quote" class="mt-3 mb-2 inline-flex items-center justify-center text-sm font-medium bg-ink text-white px-4 py-2.5 rounded-md hover:bg-slate-800 transition">
        Request a quote
      </a>
      <a href="https://www.linkedin.com/company/omicsdesk" target="_blank" rel="noopener" class="py-2 text-sm text-slate-500 hover:text-ink inline-flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        LinkedIn
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');
    if (!btn || !menu || !iconOpen || !iconClose) return;
    btn.addEventListener('click', function () {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.setAttribute('aria-label', !isOpen ? 'Close menu' : 'Open menu');
    });
  })();
</script>
