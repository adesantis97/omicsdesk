---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title = 'OmicsDesk — Omics data, read by a bioinformatician',
  description = 'Expert biological interpretation of your omics data, by a bioinformatician who studies your project: what the results mean for your system and what is worth testing next. RNA-seq, single-cell, proteomics, ChIP/ATAC-seq, methylation and multi-omics.',
  ogImage = '/og_image.png',
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}

  <link rel="icon" type="image/png" href="/og_image.png" />
  <link rel="apple-touch-icon" href="/og_image.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="OmicsDesk" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts are self-hosted (src/styles/fonts.css), so no request leaves for Google. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />

  <!--
    No third party script is loaded here on purpose. The Cloudflare Web Analytics
    beacon is injected by <CookieConsent /> only after the visitor accepts.
  -->
</head>
<body class="font-sans text-ink bg-paper antialiased">
  <Nav />
  <slot />
  <Footer />
  <CookieConsent />
</body>
</html>
