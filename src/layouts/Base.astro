---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  /** schema.org JSON-LD for this page: one object or several. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'OmicsDesk — Omics data, read by a bioinformatician',
  description = 'Expert biological interpretation of your omics data, by a bioinformatician who studies your project: what the results mean for your system and what is worth testing next. RNA-seq, single-cell, proteomics, ChIP/ATAC-seq, methylation and multi-omics.',
  ogImage = '/og_image.png',
  noIndex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}

  <link rel="icon" type="image/png" href="/og_image.png" />
  <link rel="apple-touch-icon" href="/og_image.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="OmicsDesk" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!--
    The UI font is the Apple system stack (SF Pro / Segoe UI / Roboto): nothing
    is downloaded, so there is no webfont preload and no swap flash. The only
    self-hosted face left is JetBrains Mono (src/styles/fonts.css), used by
    font-mono on a handful of labels, and it is not on the critical path.
  -->

  <!--
    No third party script is loaded here on purpose. The Cloudflare Web Analytics
    beacon is injected by <CookieConsent /> only after the visitor accepts.
  -->

  {jsonLd && <JsonLd schema={jsonLd} />}
</head>
<body class="font-sans text-ink bg-paper antialiased">
  <Nav />
  <slot />
  <Footer />
  <CookieConsent />
</body>
</html>
