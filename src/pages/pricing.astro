---
import Base from '../layouts/Base.astro';

interface Omics {
  slug: string;
  name: string;
  tagline: string;
  upTo: string;
  turnaround: string;
  deliverables: string[];
}

const services: Omics[] = [
  {
    slug: 'expert-review',
    name: 'Expert review',
    tagline: 'A second opinion on results you already have. Not a re-run, a read: do the conclusions hold?',
    upTo: '1 dataset / 1 contrast',
    turnaround: '2 business days',
    deliverables: [
      'A plain read of what the results mean for your biology',
      'The two or three things worth digging into next',
      'A check of your thresholds, outliers and normalisation choices, and what I would change and why',
      'A short methods paragraph ready for a paper or grant',
      'Credited against the project fee if it becomes a full analysis',
    ],
  },
  {
    slug: 'rnaseq',
    name: 'RNA-seq (bulk)',
    tagline: 'Which genes and pathways actually move, and what that says about your system.',
    upTo: '24 samples',
    turnaround: '7 business days',
    deliverables: [
      'A written read of the differential expression: what the signal means for your biology',
      'Pathway and TF-activity interpretation, not just a GSEA table',
      'DESeq2 differential expression with shrinkage; PCA, volcano, heatmap',
      'GSEA (GO, KEGG, Reactome) + TF activity (DoRothEA / decoupleR)',
      'Adapter trimming, splice-aware alignment and gene quantification (fastp, MultiQC)',
    ],
  },
  {
    slug: 'scrnaseq',
    name: 'scRNA-seq',
    tagline: 'Which cell populations change between conditions, and the programs driving them.',
    upTo: '16 libraries',
    turnaround: '10 business days',
    deliverables: [
      'A written read of which populations shift and what that means',
      'Cross-condition differential expression interpreted at the program level',
      'UMAP / Leiden clustering + automated cell-type annotation',
      'Marker genes per cluster; QC, doublet removal, normalization',
      'AnnData object (.h5ad) included',
    ],
  },
  {
    slug: 'proteomics',
    name: 'Proteomics',
    tagline: 'Which proteins and pathways shift at the protein level, read against your biology.',
    upTo: '24 samples',
    turnaround: '7 business days',
    deliverables: [
      'A written read of the differential abundance and its biological meaning',
      'Pathway interpretation (GO, KEGG, Reactome)',
      'MSstats / limma differential abundance; PCA, volcano, heatmap',
      'Search-engine ingest (MaxQuant, DIA-NN, FragPipe); LFQ / TMT / SILAC',
    ],
  },
  {
    slug: 'phosphoproteomics',
    name: 'Phosphoproteomics',
    tagline: 'Which signaling pathways and kinases are active, not just which sites change.',
    upTo: '24 samples',
    turnaround: '10 business days',
    deliverables: [
      'A written read of the active signaling, at the kinase and pathway level',
      'Kinase activity inference (KSEA / decoupleR) + kinase–substrate networks',
      'Phosphosite-level quantification with class-I localization',
      'All proteomics deliverables',
    ],
  },
  {
    slug: 'chipseq',
    name: 'ChIP-seq',
    tagline: 'Where a factor binds across the genome, what it regulates, and how that changes.',
    upTo: '24 samples',
    turnaround: '7 business days',
    deliverables: [
      'A written read of the binding landscape and its regulatory meaning',
      'Peak annotation + motif interpretation (ChIPseeker, HOMER)',
      'Peak calling (MACS3, narrow or broad); differential binding (DiffBind)',
      'Alignment (Bowtie2); BED / narrowPeak files included',
    ],
  },
  {
    slug: 'atacseq',
    name: 'ATAC-seq',
    tagline: 'Where chromatin opens and closes, and which regulators sit behind the change.',
    upTo: '24 samples',
    turnaround: '7 business days',
    deliverables: [
      'A written read of the accessibility changes and the regulators implicated',
      'Optional TF footprinting interpretation (TOBIAS)',
      'Accessible-region calling (MACS3 BAMPE); differential accessibility (DiffBind)',
      'ENCODE QC (TSS enrichment, fragment size); nucleosome positioning',
    ],
  },
  {
    slug: 'methylation',
    name: 'DNA methylation',
    tagline: 'Where the methylome shifts and how to read the direction correctly.',
    upTo: '24 samples',
    turnaround: '10 business days',
    deliverables: [
      'A written read of the differentially methylated regions and their meaning',
      'Genomic-context annotation so direction is interpreted correctly',
      'Per-CpG calls + DMR detection (methylKit; dmrseq / DSS on request)',
      'Bisulfite/enzymatic alignment (Bismark) with conversion-efficiency QC',
    ],
  },
];
---
<Base
  title="Services — OmicsDesk"
  description="Omics analysis read by a bioinformatician: what your data means for your biology and what to test next. RNA-seq, single-cell, proteomics, phosphoproteomics, ChIP-seq, ATAC-seq, methylation and multi-omics. Request a quote."
>
  <header class="max-w-5xl mx-auto px-5 pt-section-sm sm:pt-section pb-block">
    <p class="eyebrow mb-stack">Services &amp; how we work</p>
    <h1 class="text-title-2 sm:text-title-1 lg:text-display-sm">
      Every engagement includes the read on what it means.
    </h1>
    <p class="mt-stack text-lead text-slate-600 max-w-measure">
      Each service below is a complete engagement, scoped to your biological question and written up as an interpretation: what stands out for your system and what is worth testing next, not just a folder of figures. Fixed scope and turnaround agreed up front; a quote comes back within 2 business days.
    </p>
    <a href="mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20request%20a%20quote" class="btn-primary mt-block">
      Request a quote
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
  </header>

  <!-- Progressive disclosure: the first two deliverables carry the pitch, the
       rest sit behind a <details> so eight cards do not open as ~40 bullets.
       Native element, zero JS. -->
  <section class="max-w-5xl mx-auto px-5 pb-section-sm sm:pb-section grid md:grid-cols-2 gap-6">
    {services.map((s) => (
      <article id={s.slug} class="card p-6 flex flex-col hover:-translate-y-0.5 hover:shadow-card-hover">
        <div>
          <h2 class="text-title-3">{s.name}</h2>
          <p class="prose-p-sm mt-2">{s.tagline}</p>
        </div>
        <dl class="mt-block grid grid-cols-2 gap-3">
          <div class="bg-slate-50 rounded-tile p-4">
            <dt class="text-eyebrow text-slate-500">Typical scope</dt>
            <dd class="text-body-sm font-medium text-ink mt-1">{s.upTo}</dd>
          </div>
          <div class="bg-slate-50 rounded-tile p-4">
            <dt class="text-eyebrow text-slate-500">Turnaround</dt>
            <dd class="text-body-sm font-medium text-ink mt-1">{s.turnaround}</dd>
          </div>
        </dl>
        <div class="mt-block flex-grow">
          <ul class="space-y-2 text-body-sm text-slate-600">
            {s.deliverables.slice(0, 2).map((d) => (
              <li class="flex gap-2">
                <span class="text-accent shrink-0 mt-1.5">•</span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
          {s.deliverables.length > 2 && (
            <details class="disclosure">
              <summary>{`${s.deliverables.length - 2} more deliverables`}</summary>
              <ul class="space-y-2 text-body-sm text-slate-600 pb-1">
                {s.deliverables.slice(2).map((d) => (
                  <li class="flex gap-2">
                    <span class="text-accent shrink-0 mt-1.5">•</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
        <a
          href={`mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20quote%20for%20${encodeURIComponent(s.name)}`}
          class="btn-primary mt-block w-full"
        >
          Request a quote
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </article>
    ))}
  </section>

  <section class="section-tint">
    <div class="section-wrap grid md:grid-cols-2 gap-6">
      <div class="card-glass p-6">
        <h2 class="text-title-3">Multi-omics integration</h2>
        <p class="prose-p-sm mt-stack">
          Combine two or more omics layers into one integrated story: MOFA2 factor analysis, patient-specific regulatory networks, and cross-omics pathway convergence, interpreted as a single biological narrative rather than parallel reports.
        </p>
        <a href="mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20multi-omics%20integration" class="link-more mt-block inline-flex">
          Request a quote →
        </a>
      </div>

      <div class="card-glass p-6">
        <h2 class="text-title-3">Options &amp; add-ons</h2>
        <ul class="mt-stack space-y-2 text-body-sm text-slate-600">
          <li class="flex gap-2"><span class="text-accent shrink-0 mt-1.5">•</span><span>Rush delivery when you are working against a deadline</span></li>
          <li class="flex gap-2"><span class="text-accent shrink-0 mt-1.5">•</span><span>Larger studies, extra samples, unusual reference genomes</span></li>
          <li class="flex gap-2"><span class="text-accent shrink-0 mt-1.5">•</span><span>Follow-up re-analysis and additional contrasts</span></li>
          <li class="flex gap-2"><span class="text-accent shrink-0 mt-1.5">•</span><span>Ongoing analysis capacity on retainer, after a first project</span></li>
        </ul>
        <p class="text-caption text-slate-600 mt-block">
          15% academic discount for requests from
          <span class="font-mono text-slate-700">.edu</span> / <span class="font-mono text-slate-700">.ac.*</span> institutional emails.
        </p>
      </div>
    </div>
  </section>

  <!-- Grant and custom used to be two py-16 sections: 128px of dead air between
       two panels that make the same "write to us" point. One section, 40px apart. -->
  <section class="section-wrap">
    <div class="rounded-panel border border-accent/30 bg-accent/5 p-6 sm:p-8 md:p-10">
      <p class="eyebrow mb-stack">For academic labs</p>
      <h2 class="text-title-2">Writing or resubmitting a grant?</h2>
      <p class="prose-p mt-stack max-w-measure">
        We strengthen the proposal with real preliminary data from public sources at no cost, and write the computational arm reviewers now expect. The downstream analysis of your own data is scoped into the budget and run only if the grant is funded, paid from grant funds. Zero risk to you, and no cost until it wins.
      </p>
      <a
        href="mailto:hello@omicsdesk.com?subject=OmicsDesk%20%E2%80%94%20grant%20support"
        class="btn-primary mt-block"
      >
        Ask about grant support
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="mt-block rounded-panel border-2 border-dashed border-slate-300 p-6 sm:p-8 md:p-10">
      <p class="eyebrow mb-stack">Custom &amp; enterprise</p>
      <h2 class="text-title-2">Outside the standard scope?</h2>
      <p class="prose-p mt-stack max-w-measure">
        Studies above the typical scope, white-label work for CROs, ongoing analysis retainers, novel omics
        types (spatial, Hi-C, long-read), or unusual reference genomes are all quotable. Email with the
        details, quote back within 2 business days.
      </p>
      <a
        href="mailto:hello@omicsdesk.com?subject=Custom%20engagement%20enquiry"
        class="btn-primary mt-block"
      >
        Discuss a custom engagement
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 pb-section-sm sm:pb-section">
    <h2 class="text-title-2">What you get, every analysis</h2>
    <ul class="mt-block grid sm:grid-cols-2 gap-x-6 gap-y-2 text-body-sm text-slate-600 max-w-3xl">
      <li class="font-medium text-ink">A written biological interpretation: what it means, what to test next</li>
      <li>Branded PDF report (executive summary, methods, conclusions)</li>
      <li>Full statistical results (TSV + Excel workbook)</li>
      <li>Publication-ready figures (PNG, 300 dpi)</li>
      <li>Reproducible pipeline code (Snakemake + conda)</li>
      <li>NDA available; raw data deleted within 30 days</li>
    </ul>
    <p class="mt-block text-caption text-slate-600">
      Payment terms and a fixed quote are agreed before any work begins. EUR by default; USD invoicing available on request.
    </p>
  </section>
</Base>
