---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('publications', ({ id }) => !id.startsWith('_'));
const sorted = all.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});
---
<Base
  title="Publications — OmicsDesk"
  description="Peer-reviewed work behind OmicsDesk. Each entry: what it solved, what methods were used, why it matters."
>
  <header class="max-w-4xl mx-auto px-5 pt-section-sm sm:pt-section pb-block">
    <p class="eyebrow mb-stack">Peer-reviewed</p>
    <h1 class="text-title-2 sm:text-title-1 lg:text-display-sm">
      The work behind the analyses we ship.
    </h1>
    <p class="mt-stack text-lead text-slate-600 max-w-measure">
      Peer-reviewed publications that ground the methods I use for clients. What each paper solved,
      what was used to solve it, and why it matters for translational decisions.
    </p>
  </header>

  {sorted.length === 0 && (
    <section class="max-w-4xl mx-auto px-5 pb-section-sm sm:pb-section">
      <div class="rounded-card border-2 border-dashed border-slate-200 p-8 md:p-10 bg-slate-50">
        <h2 class="text-title-3">Publications coming soon</h2>
        <p class="prose-p-sm mt-2 max-w-measure">
          A formal publications list will appear here. In the meantime, request the sample report or
          email <a href="mailto:hello@omicsdesk.com" class="text-accent underline">hello@omicsdesk.com</a> for examples of past work.
        </p>
      </div>
    </section>
  )}

  <section class="max-w-4xl mx-auto px-5 pb-section-sm sm:pb-section grid gap-5">
    {sorted.map((p) => (
      <article class="bg-white rounded-card border border-slate-200/80 shadow-card p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="min-w-0">
            <div class="text-caption font-mono uppercase tracking-wide text-slate-600">
              {p.data.venue} · {p.data.year}
            </div>
            <h2 class="text-title-3 mt-2">
              {p.data.title}
            </h2>
            <p class="text-body-sm text-slate-600 mt-1 italic">{p.data.authors}</p>
          </div>
          {p.data.featured && (
            <span class="text-caption bg-accent/10 text-accent-dark px-2.5 py-1 rounded-pill font-medium shrink-0">Featured</span>
          )}
        </div>
        <p class="prose-p mt-4">
          <span class="font-semibold text-ink">My role: </span>
          {p.data.role}
        </p>
        <p class="prose-p mt-stack">
          <span class="font-semibold text-ink">In plain language: </span>
          {p.data.summary}
        </p>
        {p.data.methods.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {p.data.methods.map((m) => (
              <span class="text-caption bg-slate-100 text-slate-700 px-2.5 py-1 rounded-pill">{m}</span>
            ))}
          </div>
        )}
        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          {p.data.url && (
            <a href={p.data.url} target="_blank" rel="noopener" class="text-accent font-medium hover:underline">
              Read paper →
            </a>
          )}
          {p.data.doi && (
            <a href={`https://doi.org/${p.data.doi}`} target="_blank" rel="noopener" class="text-slate-600 hover:text-ink font-mono text-caption transition duration-250 ease-apple">
              DOI: {p.data.doi}
            </a>
          )}
          {p.data.pdfUrl && (
            <a href={p.data.pdfUrl} target="_blank" rel="noopener" class="text-slate-600 hover:text-ink font-medium transition duration-250 ease-apple">
              PDF
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</Base>
