---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { organization, ORG_ID, PERSON_ID, SITE } from '../../lib/schema';

const isProd = import.meta.env.PROD;
const all = await getCollection('blog', ({ data }) => !isProd || !data.draft);
const sorted = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE}/blog/#blog`,
    url: `${SITE}/blog/`,
    name: 'OmicsDesk Blog',
    description:
      'Practical, technical posts on bioinformatics workflows: tool comparisons, troubleshooting guides, and field notes from real client work.',
    inLanguage: 'en',
    publisher: { '@id': ORG_ID },
    blogPost: sorted.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${SITE}/blog/${post.slug}/#post`,
      url: `${SITE}/blog/${post.slug}/`,
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString().slice(0, 10),
      author: { '@id': PERSON_ID },
    })),
  },
  { '@context': 'https://schema.org', ...organization },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'OmicsDesk', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
    ],
  },
];
---
<Base
  title="Blog — OmicsDesk"
  description="Practical, technical posts on bioinformatics workflows: tool comparisons, troubleshooting guides, and field notes from real client work."
  jsonLd={jsonLd}
>
  <header class="max-w-4xl mx-auto px-5 pt-section-sm sm:pt-section pb-block">
    <p class="eyebrow mb-stack">Notes from the bench</p>
    <h1 class="text-title-2 sm:text-title-1 lg:text-display-sm">
      Bioinformatics, with the receipts.
    </h1>
    <p class="mt-stack text-lead text-slate-600 max-w-measure">
      Specific troubleshooting, tool comparisons, and workflow notes from real client projects.
      No "intro to RNA-seq" — only the parts that actually trip people up.
    </p>
  </header>

  {sorted.length === 0 && (
    <section class="max-w-4xl mx-auto px-5 pb-section-sm sm:pb-section">
      <div class="rounded-card border-2 border-dashed border-slate-200 p-8 md:p-10 bg-slate-50">
        <h2 class="text-title-3">First post coming soon</h2>
        <p class="prose-p-sm mt-2">
          New posts every 2–3 weeks. Check back, or subscribe by emailing
          <a href="mailto:hello@omicsdesk.com" class="text-accent underline">hello@omicsdesk.com</a>.
        </p>
      </div>
    </section>
  )}

  <section class="max-w-4xl mx-auto px-5 pb-section-sm sm:pb-section grid sm:grid-cols-2 gap-5">
    {sorted.map((post) => (
      <a href={`/blog/${post.slug}/`} class="flex flex-col overflow-hidden bg-white rounded-card border border-slate-200/80 shadow-card hover:border-accent/40 hover:shadow-card-hover hover:-translate-y-0.5 transition group">
        <div class="aspect-[16/9] bg-slate-50 border-b border-slate-200/80 overflow-hidden flex items-center justify-center">
          {post.data.heroImage ? (
            <img
              src={post.data.heroImage}
              alt={post.data.heroAlt ?? post.data.title}
              class="w-full h-full object-contain group-hover:scale-[1.02] transition"
              loading="lazy"
            />
          ) : (
            <span class="text-caption font-mono uppercase tracking-wide text-slate-500">OmicsDesk</span>
          )}
        </div>
        <div class="p-6 flex flex-col flex-1">
          <div class="text-caption font-mono uppercase tracking-wide text-slate-600">
            {post.data.pubDate.toISOString().slice(0, 10)}
            {post.data.draft && <span class="ml-2 text-amber-600">DRAFT</span>}
          </div>
          <h2 class="text-title-3 mt-2 leading-snug transition duration-250 ease-apple group-hover:text-accent">
            {post.data.title}
          </h2>
          <p class="prose-p-sm mt-stack">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <div class="mt-4 pt-1 flex flex-wrap gap-1.5 items-end flex-1">
              {post.data.tags.map((t) => (
                <span class="text-caption bg-slate-100 text-slate-700 px-2.5 py-1 rounded-pill">#{t}</span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </section>
</Base>
